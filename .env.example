# GitHub OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://127.0.0.1:8080/callback
# Public repository read-only verification does not require an extra scope.
GITHUB_OAUTH_SCOPE=
# collect_saved supports microsoft/vscode, kubernetes/kubernetes,
# and scikit-learn/scikit-learn. oauth_server accepts any OWNER/REPO.
GITHUB_REPOSITORY=microsoft/vscode
OAUTH_OUTPUT_DIR=data/oauth

# Optional local debugging
GITHUB_TOKEN=

# LLM provider
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
